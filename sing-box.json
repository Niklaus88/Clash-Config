          "stun"
        ],
        "outbound": "block"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "节点选择"
      },
      {
        "process_name": [
          "tune_free_next.exe"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "tf-pay.sayqz.com",
