        "outbound": "节点选择"
      },
      {
        "domain": [
          "v2rayse.com"
        ],
        "outbound": "节点选择"
      },
      {
        "rule_set": "reject",
        "outbound": "广告过滤"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "全局直连"
      },
      {
        "rule_set": "icloud",
        "outbound": "微软服务"
      },
      {
        "rule_set": "apple",
        "outbound": "苹果服务"
      },
      {
        "rule_set": "youtube",
        "outbound": "YouTube"
      },
      {
