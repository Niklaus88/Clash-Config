      "outbounds": [
        "全局直连",
        "节点选择"
      ]
    },
    {
      "tag": "广告过滤",
      "type": "selector",
      "outbounds": [
        "block",
        "direct"
      ]
    },
    {
      "tag": "漏网之鱼",
      "type": "selector",
      "outbounds": [
        "节点选择",
        "全局直连"
      ]
    },
    {
      "tag": "全局直连",
      "type": "direct"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "全局拦截",
      "type": "block"
    },
    {
      "tag": "block",
      "type": "block"
    },
    {
      "tag": "自建-示例节点",
      "type": "shadowsocks",
      "server": "1.2.3.4",
      "server_port": 8388,
      "method": "chacha20-ietf-poly1305",
      "password": "your_password"
    }
  ],
  "route": {
    "default_domain_resolver": "dns_direct",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "port": [
          3478,
          5349,
          19302,
          19303,
          19304,
          19305,
          19306,
          19307,
          19308,
          19309
